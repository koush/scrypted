{
    "compilerOptions": {
        "module": "es2022",
        "target": "ES2021",
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "sourceMap": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ]
